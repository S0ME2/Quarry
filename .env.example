# Infrastructure secrets. Keep .env private; never commit it.
DATABASE_URL=
# Required before saving administrator credentials. Generate once with:
# python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# Back up this key securely; changing it makes saved credentials unreadable.
QUARRY_SETTINGS_ENCRYPTION_KEY=

# Dedicated test database only; never point tests at customer data.
TEST_DATABASE_URL=
# Required only for the bundled PostgreSQL Compose service.
POSTGRES_PASSWORD=

# For an explicitly enabled monitoring deployment, set both:
# QUARRY_MANUAL_ONLY=false
# QUARRY_OPERATOR_WORKER_ENABLED=true
# Local defaults leave background monitoring disabled.
# Legacy provider, SMTP and other optional settings: docs/operations/OPTIONAL_ENV.md
